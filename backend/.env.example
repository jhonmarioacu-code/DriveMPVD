DRIVEMPVD_APP_NAME=DriveMPVD
DRIVEMPVD_APP_VERSION=0.1.0
DRIVEMPVD_ENVIRONMENT=development
DRIVEMPVD_API_PREFIX=/api/v1
DRIVEMPVD_LOG_LEVEL=INFO
DRIVEMPVD_DATABASE_URL=postgresql+asyncpg://drivempvd:replace-me@postgres:5432/drivempvd
DRIVEMPVD_STORAGE_ROOT=/data/storage
DRIVEMPVD_MAX_UPLOAD_SIZE_BYTES=53687091200
DRIVEMPVD_DEFAULT_PAGE_SIZE=50
DRIVEMPVD_MAX_PAGE_SIZE=200
DRIVEMPVD_DOCS_ENABLED=true
