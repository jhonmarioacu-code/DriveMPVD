DRIVEMPVD_APP_NAME=DriveMPVD
DRIVEMPVD_APP_VERSION=0.1.0
DRIVEMPVD_ENVIRONMENT=development
DRIVEMPVD_API_PREFIX=/api/v1
DRIVEMPVD_LOG_LEVEL=INFO
DRIVEMPVD_DATABASE_URL=postgresql+asyncpg://drivempvd:replace-me@postgres:5432/drivempvd
DRIVEMPVD_DATABASE_POOL_SIZE=10
DRIVEMPVD_DATABASE_MAX_OVERFLOW=10
DRIVEMPVD_DATABASE_POOL_TIMEOUT_SECONDS=30
DRIVEMPVD_DATABASE_STATEMENT_TIMEOUT_MS=30000
DRIVEMPVD_DATABASE_ECHO=false
DRIVEMPVD_STORAGE_ROOT=/data/storage
DRIVEMPVD_MAX_UPLOAD_SIZE_BYTES=53687091200
DRIVEMPVD_DEFAULT_PAGE_SIZE=50
DRIVEMPVD_MAX_PAGE_SIZE=200
DRIVEMPVD_DOCS_ENABLED=true
DRIVEMPVD_JWT_ISSUER=drivempvd
DRIVEMPVD_JWT_AUDIENCE=drivempvd-api
DRIVEMPVD_JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
DRIVEMPVD_JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
DRIVEMPVD_AUTH_SECRET_PEPPER=replace-with-an-independent-32-byte-secret
DRIVEMPVD_ACCESS_TOKEN_TTL_SECONDS=900
DRIVEMPVD_REFRESH_TOKEN_TTL_SECONDS=604800
DRIVEMPVD_ARGON2_TIME_COST=3
DRIVEMPVD_ARGON2_MEMORY_COST_KIB=65536
DRIVEMPVD_ARGON2_PARALLELISM=2
DRIVEMPVD_MINIMUM_PASSWORD_LENGTH=12
DRIVEMPVD_MAXIMUM_FAILED_LOGINS=5
DRIVEMPVD_ACCOUNT_LOCK_SECONDS=900
DRIVEMPVD_LOGIN_RATE_LIMIT=10
DRIVEMPVD_LOGIN_RATE_WINDOW_SECONDS=60
DRIVEMPVD_LOGIN_RATE_BLOCK_SECONDS=300
DRIVEMPVD_REFRESH_RATE_LIMIT=30
DRIVEMPVD_REFRESH_RATE_WINDOW_SECONDS=60
DRIVEMPVD_REFRESH_RATE_BLOCK_SECONDS=300
DRIVEMPVD_AUTH_COOKIE_SECURE=true
DRIVEMPVD_ACCESS_COOKIE_NAME=drivempvd_access
DRIVEMPVD_REFRESH_COOKIE_NAME=drivempvd_refresh
DRIVEMPVD_CSRF_COOKIE_NAME=drivempvd_csrf
DRIVEMPVD_CSRF_HEADER_NAME=X-CSRF-Token
