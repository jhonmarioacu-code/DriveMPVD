# Copy to docker/.env for an HTTP-only local or staging deployment.
# This file intentionally keeps cookies non-Secure so the smoke test can run on
# http://localhost. Use .env.production.example before exposing the service.
COMPOSE_PROJECT_NAME=drivempvd
# Keep a distinct tag for each production release. The local value is safe for
# disposable development only and is intentionally overwritten by rebuilds.
DRIVEMPVD_IMAGE_TAG=local

POSTGRES_DB=drivempvd
POSTGRES_USER=drivempvd
POSTGRES_PASSWORD=replace-this-local-postgresql-password
DRIVEMPVD_DATABASE_URL=postgresql+asyncpg://drivempvd:replace-this-local-postgresql-password@postgres:5432/drivempvd

DRIVEMPVD_APP_NAME=DriveMPVD
DRIVEMPVD_APP_VERSION=0.1.0
DRIVEMPVD_ENVIRONMENT=development
DRIVEMPVD_LOG_LEVEL=INFO
DRIVEMPVD_DOCS_ENABLED=true
DRIVEMPVD_STORAGE_ROOT=/data/storage
# Create this path with owner 10001:10001 before starting Compose; the API does
# not run as root and must be able to write staging and objects.
DRIVEMPVD_STORAGE_PATH=./data/storage
DRIVEMPVD_STORAGE_STREAM_BLOCK_SIZE_BYTES=1048576
DRIVEMPVD_STORAGE_WRITE_BUFFER_SIZE_BYTES=1048576
DRIVEMPVD_MAX_UPLOAD_SIZE_BYTES=53687091200
DRIVEMPVD_MAX_UPLOAD_CHUNK_SIZE_BYTES=16777216

DRIVEMPVD_JWT_ACCESS_SECRET=replace-this-local-access-secret-with-32-bytes
DRIVEMPVD_JWT_REFRESH_SECRET=replace-this-local-refresh-secret-with-32-bytes
DRIVEMPVD_AUTH_SECRET_PEPPER=replace-this-local-pepper-with-32-bytes
DRIVEMPVD_AUTH_COOKIE_SECURE=false

VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=drivempvd_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token

DRIVEMPVD_HTTP_PORT=8080
DRIVEMPVD_HTTPS_PORT=8443
DRIVEMPVD_TLS_ENABLED=false
DRIVEMPVD_TLS_CERTIFICATES_PATH=./docker/certificates
DRIVEMPVD_ACME_WEBROOT_PATH=./docker/acme-webroot
DRIVEMPVD_NGINX_CLIENT_MAX_BODY_SIZE=50g
