worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format json escape=json
        '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
        '"request_id":"$request_id","method":"$request_method",'
        '"uri":"$uri","protocol":"$server_protocol",'
        '"status":$status,"bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
    access_log /dev/stdout json;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 1000;
    server_tokens off;

    client_max_body_size ${DRIVEMPVD_NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_buffer_size 1m;
    client_body_timeout 3600s;
    send_timeout 3600s;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;

    # Docker embedded DNS is queried through proxy_pass variables so recreated
    # api/frontend containers do not leave Nginx with a stale upstream IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss
        application/manifest+json
        image/svg+xml;

    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=refresh:10m rate=30r/m;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=per_ip:10m;
    limit_conn_zone $binary_remote_addr zone=uploads_per_ip:10m;
    limit_conn_status 429;

    include /tmp/drivempvd-nginx/conf.d/*.conf;
}
