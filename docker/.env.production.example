# Copy to docker/.env only after replacing every placeholder with a unique
# production value. Keep this file out of deployment hosts after provisioning.
COMPOSE_PROJECT_NAME=drivempvd
# Set this to an immutable release identifier before each deployment. Changing
# COMPOSE_PROJECT_NAME would create a different PostgreSQL volume.
DRIVEMPVD_IMAGE_TAG=replace-with-release-tag

POSTGRES_DB=drivempvd
POSTGRES_USER=drivempvd
POSTGRES_PASSWORD=replace-with-a-unique-postgresql-password
DRIVEMPVD_DATABASE_URL=postgresql+asyncpg://drivempvd:replace-with-a-unique-postgresql-password@postgres:5432/drivempvd

DRIVEMPVD_APP_NAME=DriveMPVD
DRIVEMPVD_APP_VERSION=0.1.0
DRIVEMPVD_ENVIRONMENT=production
DRIVEMPVD_LOG_LEVEL=INFO
DRIVEMPVD_DOCS_ENABLED=false
DRIVEMPVD_STORAGE_ROOT=/data/storage
DRIVEMPVD_STORAGE_PATH=/data/storage
DRIVEMPVD_STORAGE_STREAM_BLOCK_SIZE_BYTES=1048576
DRIVEMPVD_STORAGE_WRITE_BUFFER_SIZE_BYTES=1048576
DRIVEMPVD_MAX_UPLOAD_SIZE_BYTES=53687091200
DRIVEMPVD_MAX_UPLOAD_CHUNK_SIZE_BYTES=16777216

DRIVEMPVD_JWT_ACCESS_SECRET=replace-with-a-unique-32-byte-access-secret
DRIVEMPVD_JWT_REFRESH_SECRET=replace-with-a-different-32-byte-refresh-secret
DRIVEMPVD_AUTH_SECRET_PEPPER=replace-with-a-third-32-byte-pepper
DRIVEMPVD_AUTH_COOKIE_SECURE=true

VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=drivempvd_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token

DRIVEMPVD_HTTP_PORT=80
DRIVEMPVD_HTTPS_PORT=443
DRIVEMPVD_TLS_ENABLED=true
# This directory must contain regular, dereferenced fullchain.pem and
# privkey.pem files. Do not mount Certbot's live/ directory directly: its PEMs
# are normally symlinks into archive/.
DRIVEMPVD_TLS_CERTIFICATES_PATH=/etc/drivempvd/tls
DRIVEMPVD_ACME_WEBROOT_PATH=/var/lib/drivempvd/acme-webroot
DRIVEMPVD_NGINX_CLIENT_MAX_BODY_SIZE=50g
